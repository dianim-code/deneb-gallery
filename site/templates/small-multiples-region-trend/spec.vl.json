{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.3.json",
  "description": "Small multiples: one line per region showing ordinary beds per 1,000 residents, 2021 to 2023. Each panel has its own y scale.",
  "title": {
    "text": "Ordinary beds per 1,000 residents by region, 2021-2023",
    "subtitle": "One panel per region, independent y scales. All disciplines, ordinary regime only."
  },
  "data": {
    "url": "data/regions_by_year.json"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "system-ui, -apple-system, Segoe UI, sans-serif",
    "title": {
      "color": "#0b0b0b",
      "subtitleColor": "#767676",
      "anchor": "start",
      "fontSize": 15,
      "subtitlePadding": 6,
      "offset": 20
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#e4e3df",
      "domainColor": "#a8a69e",
      "tickColor": "#a8a69e"
    },
    "header": {
      "labelColor": "#0b0b0b",
      "titleColor": "#52514e"
    }
  },
  "facet": {
    "field": "region_name",
    "type": "nominal",
    "sort": {
      "field": "region_order",
      "op": "min",
      "order": "ascending"
    },
    "title": null,
    "header": {
      "labelFontSize": 11,
      "labelAnchor": "start"
    }
  },
  "columns": 4,
  "spec": {
    "width": 150,
    "height": 90,
    "mark": {
      "type": "line",
      "color": "#2a78d6",
      "point": {
        "filled": true,
        "size": 30,
        "color": "#2a78d6"
      },
      "strokeWidth": 2
    },
    "encoding": {
      "x": {
        "field": "year",
        "type": "ordinal",
        "title": null,
        "axis": {
          "labelAngle": 0
        }
      },
      "y": {
        "field": "beds_per_1000",
        "type": "quantitative",
        "title": null,
        "scale": {
          "zero": false
        }
      },
      "tooltip": [
        {
          "field": "region_name",
          "type": "nominal",
          "title": "Region"
        },
        {
          "field": "year",
          "type": "ordinal",
          "title": "Year"
        },
        {
          "field": "beds_per_1000",
          "type": "quantitative",
          "title": "Beds per 1,000",
          "format": ".2f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
