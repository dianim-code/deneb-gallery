{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.3.json",
  "description": "Heatmap: ordinary beds per 1,000 residents by discipline (rows) and region (columns), 2023, for the ten largest disciplines by national ordinary beds.",
  "title": {
    "text": "Ordinary beds per 1,000 residents by discipline and region, 2023",
    "subtitle": "Ten largest disciplines by national ordinary beds. Rows sorted by national total. Hover a cell for the value."
  },
  "width": "container",
  "height": {
    "step": 22
  },
  "data": {
    "url": "../../site/data/discipline_region_2023.json"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "system-ui, -apple-system, Segoe UI, sans-serif",
    "title": {
      "color": "#0b0b0b",
      "subtitleColor": "#767676",
      "anchor": "start",
      "fontSize": 15,
      "subtitlePadding": 6,
      "offset": 20
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#e4e3df",
      "domainColor": "#a8a69e",
      "tickColor": "#a8a69e"
    },
    "legend": {
      "labelColor": "#52514e",
      "titleColor": "#52514e"
    }
  },
  "mark": {
    "type": "rect",
    "stroke": "#fcfcfb",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "region_name",
      "type": "nominal",
      "sort": {
        "field": "region_order",
        "op": "min",
        "order": "ascending"
      },
      "title": null,
      "axis": {
        "labelAngle": -45
      }
    },
    "y": {
      "field": "discipline_name",
      "type": "nominal",
      "sort": {
        "field": "beds_per_1000",
        "op": "sum",
        "order": "descending"
      },
      "title": null
    },
    "color": {
      "field": "beds_per_1000",
      "type": "quantitative",
      "title": "Beds per 1,000",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "orient": "bottom",
        "gradientLength": 320
      }
    },
    "tooltip": [
      {
        "field": "discipline_name",
        "type": "nominal",
        "title": "Discipline"
      },
      {
        "field": "region_name",
        "type": "nominal",
        "title": "Region"
      },
      {
        "field": "beds_per_1000",
        "type": "quantitative",
        "title": "Beds per 1,000",
        "format": ".2f"
      }
    ]
  },
  "transform": [
    {
      "filter": "isValid(datum['beds_per_1000'])"
    }
  ]
}
